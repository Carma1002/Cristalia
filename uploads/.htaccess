# Sólo imágenes; nunca ejecutar scripts subidos
Options -Indexes
<FilesMatch "\.(php|phtml|php\d|phar|pl|py|cgi|sh|html?)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
